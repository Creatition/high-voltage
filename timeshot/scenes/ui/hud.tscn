[gd_scene load_steps=4 format=3 uid="uid://timeshot_hud"]

[ext_resource type="Script" path="res://scenes/ui/hud.gd" id="1_hud"]
[ext_resource type="PackedScene" path="res://scenes/ui/pause_menu.tscn" id="2_pause"]
[ext_resource type="PackedScene" path="res://scenes/ui/minimap.tscn" id="3_mm"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="Top" type="HBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_vertical = 0
alignment = 0

[node name="HeartsBox" type="HBoxContainer" parent="Margin/Top"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="CurrencyBox" type="HBoxContainer" parent="Margin/Top"]
layout_mode = 2
size_flags_horizontal = 10

[node name="CurrencyLabel" type="Label" parent="Margin/Top/CurrencyBox"]
layout_mode = 2
text = "$ 0"
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)

[node name="MinimapBox" type="HBoxContainer" parent="Margin/Top"]
layout_mode = 2
size_flags_horizontal = 8

[node name="Minimap" parent="Margin/Top/MinimapBox" instance=ExtResource("3_mm")]

[node name="Bottom" type="HBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_vertical = 8
alignment = 0

[node name="UpgradesBox" type="HBoxContainer" parent="Margin/Bottom"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PauseMenu" parent="." instance=ExtResource("2_pause")]
