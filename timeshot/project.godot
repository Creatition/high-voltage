; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Timeshot"
config/description="Time-travel bullet-hell roguelike. Solo-dev project by High Voltage."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
InputManager="*res://scripts/autoload/input_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
UpgradePool="*res://scripts/autoload/upgrade_pool.gd"
EraRegistry="*res://scripts/autoload/era_registry.gd"
CharacterRegistry="*res://scripts/autoload/character_registry.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
Juice="*res://scripts/autoload/juice.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
